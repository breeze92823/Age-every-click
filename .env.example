# Copy to .env or .env.local (both gitignored) and adjust as needed.

# Forces the game to treat the Bloxity SDK (sdk.bloxity.io) and avatar CDN
# (static.bloxity.io) as unavailable, regardless of whether they actually
# load. Useful for local dev when those hosts are blocked, slow, or simply
# not worth waiting on — the scene boots straight onto the capsule/keyboard
# fallback and signed-out HUD state instead of racing the real CDN.
# Unset or "false" (default): try the real SDK/CDN as normal.
VITE_DEV_MODE=false
