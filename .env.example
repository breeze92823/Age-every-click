# Copy to .env or .env.local (both gitignored) and adjust as needed.

# Forces the game to treat the Bloxity SDK (sdk.bloxity.io) and avatar CDN
# (static.bloxity.io) as unavailable, regardless of whether they actually
# load. Useful for local dev when those hosts are blocked, slow, or simply
# not worth waiting on — the scene boots straight onto the capsule/keyboard
# fallback and signed-out HUD state instead of racing the real CDN.
# Unset or "false" (default): try the real SDK/CDN as normal.
VITE_DEV_MODE=false

# Shows the "FREE"/"SHOP"/"PETS" billboard labels above those hub landmarks.
# The models themselves always render — only the labels are temporarily
# hidden by default since they aren't content-ready yet.
# Unset or "false" (default): labels hidden. "true": labels shown.
VITE_SHOW_SHOP_FREE_PETS_LABELS=false

# Age-every-click-backend WebSocket URL (see src/data/net.js). Unset locally
# to run against a local `npm start` in ../Age-every-click-backend at its
# default ws://localhost:2567 -- zero .env setup needed for local dev. Only
# VITE_SERVER_URL_MAIN needs a real value (the deployed prod-channel
# hostname); it's read only in a production build (`npm run build`).
VITE_SERVER_URL_DEV=
VITE_SERVER_URL_MAIN=
